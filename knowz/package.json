{
  "name": "@knowzai/mcp",
  "version": "0.11.0",
  "description": "Frictionless knowledge management across Knowz vaults -- search, save, and query knowledge through the knowz CLI when it is installed, or the Knowz MCP server otherwise",
  "type": "module",
  "bin": {
    "knowz-mcp": "bin/knowz-mcp.mjs"
  },
  "files": [
    "bin/",
    "CHANGELOG.md",
    "agents/",
    "skills/",
    ".claude-plugin/",
    ".grok-plugin/",
    ".mcp.json",
    "platform_adapters.md",
    "knowz-vaults.example.md",
    "knowz-pending.example.md",
    "enterprise.example.json"
  ],
  "scripts": {
    "prepublishOnly": "node bin/knowz-mcp.mjs --version"
  },
  "keywords": [
    "ai",
    "knowledge",
    "knowz",
    "mcp",
    "vaults",
    "claude",
    "codex",
    "gemini",
    "grok",
    "knowledge-management",
    "semantic-search"
  ],
  "author": {
    "name": "Alex Headscarf",
    "url": "https://github.com/knowz-io"
  },
  "homepage": "https://github.com/knowz-io/knowz",
  "bugs": {
    "url": "https://github.com/knowz-io/knowz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowz-io/knowz.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
